{% extends 'base.html.twig' %}

{% block title %}{{ prestation.nom }} - Locky{% endblock %}

{% block body %}
<div class="container">
    <div class="row">
        <div class="col-lg-8">
            <div class="card shadow-sm">
                <div class="card-header bg-white d-flex justify-content-between align-items-center">
                    <h1 class="h5 mb-0">{{ prestation.nom }}</h1>
                    <span class="badge text-bg-success">
                        {{ prestation.remuneration|number_format(2, ',', ' ') }} €
                    </span>
                </div>
                <div class="card-body">
                    <p class="text-muted small mb-3">
                        Demande du {{ prestation.dateCreation|date('d/m/Y') }}
                    </p>

                    <p class="lead">{{ prestation.extrait }}</p>

                    <p class="mb-0">{{ prestation.description|nl2br }}</p>

                    {% if prestation.telephone %}
                        <hr>
                        <p class="mb-0">
                            <span class="text-muted">Téléphone :</span> {{ prestation.telephone }}
                        </p>
                    {% endif %}
                </div>
                <div class="card-footer bg-white">
                    <a href="{{ path('app_home') }}" class="btn btn-outline-secondary btn-sm">Retour à l'accueil</a>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
